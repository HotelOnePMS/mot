{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "node scripts/vercel-build.mjs",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/channels/cron?full=1", "schedule": "0 10 * * *" },
    { "path": "/api/cron/purge-guest-ids", "schedule": "30 9 * * *" }
  ]
}
