generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  country           String?
  role              UserRole            @default(CUSTOMER)
  isActive          Boolean             @default(true)
  // Bumped whenever sign-in-relevant data changes (role, active flag, password, email); sessions carry the value they were issued with.
  sessionVersion    Int                 @default(0)
  // True for a password set by someone else (team invite / owner-set temporary password): must be changed at first sign-in.
  mustChangePassword Boolean            @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  bookings          Booking[]
  // Properties assigned to this user (for Owner, Manager roles)
  assignedProperties UserPropertyAssignment[]
  // Housekeeping tasks assigned to this user
  housekeepingTasks  RoomHousekeeping[]
  // Agentic-mode audit trail entries created by this user
  agentAuditLogs     AgentAuditLog[]
  // Pending password-reset links (only a hash of each token is stored)
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// One-time password-reset link. Only the SHA-256 of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Property {
  id          String          @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  zipCode     String
  phone       String
  email       String?
  amenities   String[]
  isActive    Boolean         @default(true)
  // SaaS branding / onboarding fields
  tagline      String?
  primaryColor String?
  logoUrl      String?
  type         String? // Hotel | Motel | Inn | B&B | Boutique | Other
  isDemo       Boolean         @default(false)
  // Classic (traditional UI) vs Agentic (natural-language beta interface)
  interfaceMode InterfaceMode  @default(CLASSIC)
  // How the hotel adopted StayOS: everything on StayOS, keeping their PMS, or voice only
  setupPath     SetupPath      @default(FULL)
  // Online payments (Stripe Connect Express, direct charges): the hotel's own connected account.
  stripeAccountId        String?        @unique
  stripeChargesEnabled   Boolean        @default(false)
  stripePayoutsEnabled   Boolean        @default(false)
  stripeDetailsSubmitted Boolean        @default(false)
  paymentPolicy          PaymentPolicy  @default(PAY_AT_PROPERTY)
  // Nights charged at booking when paymentPolicy is DEPOSIT.
  depositNights          Int            @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]
  payments    Payment[]
  disputes    Dispute[]
  photos      PropertyPhoto[]
  roomTypes   RoomType[]
  rooms       Room[]
  // Users assigned to this property
  assignedUsers UserPropertyAssignment[]
  // Agentic-mode audit trail
  agentAuditLogs AgentAuditLog[]
  voiceAgent     VoiceAgentConfig?
  phoneLine      VoicePhoneLine?
  voiceSessions  VoiceSession[]
  guestRequests  GuestRequest[]
  pmsConnection  PmsConnection?
  bridgeTasks    BridgeTask[]
  agentSkills    AgentSkill[]
  agentApiKeys   AgentApiKey[]

  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model RoomType {
  id               String             @id @default(cuid())
  propertyId       String
  name             String
  description      String?
  capacity         Int
  basePrice        Decimal            @db.Decimal(10, 2)
  totalRooms       Int                @default(0)
  amenities        String[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  roomAvailability RoomAvailability[]
  photos           RoomTypePhoto[]
  dailyRates       RoomTypeRate[]
  rooms            Room[]
  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("room_types")
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime
  totalRooms  Int
  bookedRooms Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_availabilities")
}

model RoomTypePhoto {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  publicId   String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_photos")
}

model Booking {
  id            String                 @id @default(cuid())
  userId        String
  propertyId    String
  roomTypeId    String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int                    @default(1)
  totalPrice    Decimal                @db.Decimal(10, 2)
  status        BookingStatus          @default(PENDING)
  // Short human-friendly confirmation code staff and guests can say out loud.
  code          String?                @unique
  notes         String?
  // Physical room assigned at (or before) check-in.
  roomId        String?
  // Payment metadata (no raw card data is ever stored — PCI compliance).
  // Card payments go through Stripe Checkout; otherwise pay at property.
  paymentStatus          String?               @default("UNPAID")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  cardLast4     String?
  cardBrand     String?                // Visa, Mastercard, Amex, etc.
  billingName   String?
  billingZip    String?
  /// Direct bookings by an integration's API key: the contact email it sent. Those bookings belong to a
  /// guest record made for that booking alone, never to an existing account (see src/server/concierge).
  guestEmail    String?
  /// Online payments: what is charged at booking (deposit or full amount); null for pay-at-property bookings.
  paymentDue    Decimal?               @db.Decimal(10, 2)
  /// Unpaid online bookings hold their rooms until this moment, then are released.
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  payments      Payment[]
  disputes      Dispute[]
  policyAcceptance BookingPolicyAcceptance?
  checklist     BookingChecklist?
  statusHistory BookingStatusHistory[]
  property      Property               @relation(fields: [propertyId], references: [id])
  roomType      RoomType               @relation(fields: [roomTypeId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])
  room          Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([propertyId, checkIn])
  @@index([propertyId, checkOut])
  @@index([roomTypeId, checkIn, checkOut])
  @@index([roomId])
  @@index([status, paymentStatus, expiresAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  notes     String?
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

model RoomTypeRate {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_type_rates")
}

enum PaymentPolicy {
  PAY_AT_PROPERTY
  DEPOSIT
  FULL_PREPAYMENT
}

enum UserRole {
  ADMIN
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPER
  CUSTOMER
}

// Per-property UI mode: CLASSIC (traditional dashboards/tables/forms, default)
// vs AGENTIC (natural-language beta command interface).
enum InterfaceMode {
  CLASSIC
  AGENTIC
}

// Audit trail for agentic-mode usage: every agent command and every
// interface-mode switch is logged here (who, which property, what, when).
/// Agents StayOS created at a voice provider (e.g. ElevenLabs), one per audience.
/// configHash lets the server update the agent when its tools or settings change.
model VoiceProviderAgent {
  key        String   @id // "elevenlabs:<account>:<env>:GUEST" | ":STAFF" | ":PHONE:<propertyId>" | ":tool:…"
  externalId String
  configHash String
  updatedAt  DateTime @updatedAt

  @@map("voice_provider_agents")
}

/// Single-use signed agent plans: claimed (by nonce) before any step runs.
model ExecutedPlan {
  nonce      String   @id
  propertyId String
  userId     String
  createdAt  DateTime @default(now())

  @@map("executed_plans")
}

model AgentAuditLog {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  action     String // MODE_SWITCH | COMMAND
  detail     String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("agent_audit_logs")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

// Individual room with room number
model Room {
  id           String             @id @default(cuid())
  propertyId   String
  roomTypeId   String
  roomNumber   String
  floor        String?
  status       RoomStatus         @default(CLEAN)
  isOutOfOrder Boolean            @default(false)
  outOfOrderReason String?
  notes        String?
  // Free-form features used for guest preferences: quiet, accessible, corner, view...
  tags         String[]           @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  housekeeping RoomHousekeeping[]
  bookings     Booking[]

  @@unique([propertyId, roomNumber])
  @@map("rooms")
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
}

// Housekeeping task for a room
model RoomHousekeeping {
  id          String              @id @default(cuid())
  roomId      String
  assignedTo  String?
  status      HousekeepingStatus  @default(PENDING)
  priority    Int                 @default(1)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee    User?               @relation(fields: [assignedTo], references: [id])

  @@map("room_housekeeping")
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
}

// User-Property assignment for role-based access
model UserPropertyAssignment {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("user_property_assignments")
}

enum SetupPath {
  FULL
  BRIDGE
  VOICE
}

/// Voice front desk settings (GPT-Live). One per property.
model VoiceAgentConfig {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  enabled      Boolean  @default(true)
  voice        String   @default("marin")
  greeting     String?
  /// House style and rules for the voice ("we never quote parking prices", "always offer breakfast").
  instructions String?
  /// Frequently asked questions: [{ "q": string, "a": string }]
  faqs         Json     @default("[]")
  /// Where callers are sent when a person is needed.
  handoffPhone String?
  /// Show "Talk to us" on the public booking page.
  guestWidget  Boolean  @default(true)
  /// Hotels that keep their own system (voice only, keep your PMS): their own times ("15:00") and policy.
  /// Hotels running fully on HotelOne always quote the booking engine's policy.
  checkInTime        String?
  checkOutTime       String?
  cancellationPolicy String?
  /// Where new messages and booking requests from callers are emailed (comma-separated).
  notifyEmail        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("voice_agent_configs")
}

/// One voice conversation (usage + outcome), guest or staff.
model VoiceSession {
  id              String    @id @default(cuid())
  /// Null only for GLOBAL sessions (the cross-hotel concierge) and concierge rate-limit hits.
  propertyId      String?
  userId          String?
  audience        String // GUEST | STAFF (SYSTEM for concierge rate-limit hits)
  /// HOTEL (one hotel's agent, propertyId set) | GLOBAL (the concierge across all hotels)
  scope           String    @default("HOTEL")
  channel         String    @default("WEB") // WEB | PHONE | WHATSAPP | RATE_LIMIT (src/server/concierge/rateLimit.ts)
  clientKey       String? // hashed caller (IP or caller ID + property) for guest rate limits
  /// Phone calls: the caller's number as the carrier passed it (callback default).
  callerNumber    String?
  liveSessionId   String?
  toolCalls       Int       @default(0)
  summary         String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startedAt])
  @@index([clientKey, startedAt])
  @@index([channel, startedAt])
  @@map("voice_sessions")
}

/// A hotel's phone line. StayOS keeps one phone agent per hotel at the voice
/// provider; whoever runs the provider account points numbers at it there.
model VoicePhoneLine {
  propertyId     String   @id
  enabled        Boolean  @default(true)
  /// Where callers who ask for a person are put through (E.164). Must not forward back to the line.
  transferNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("voice_phone_lines")
}

/// Callback / message requests captured by the voice agent for the team.
model GuestRequest {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  phone       String?
  email       String?
  message     String
  source      String   @default("VOICE")
  status      String   @default("NEW") // NEW | DONE
  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status, createdAt])
  @@map("guest_requests")
}

enum PmsConnectionMode {
  DESKTOP
  CLOUD
  /// The PMS vendor's own MCP server (src/server/pms): loginUrl is the MCP endpoint, credentialsCipher its sealed auth.
  MCP
}

enum PmsConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  PAUSED
}

/// A hotel's existing PMS that StayOS operates for them instead of migrating.
model PmsConnection {
  id                String              @id @default(cuid())
  propertyId        String              @unique
  system            String
  mode              PmsConnectionMode
  status            PmsConnectionStatus @default(PENDING)
  loginUrl          String?
  /// AES-256-GCM sealed JSON — CLOUD: { username, password, totpSecret? }; MCP: { type, token?, headerName? }. Never returned to clients.
  credentialsCipher String?
  /// Desktop pairing: short code shown in the console, exchanged once for a device token.
  pairingCode       String?             @unique
  pairingExpiresAt  DateTime?
  /// SHA-256 of the connector's device token.
  deviceTokenHash   String?             @unique
  deviceName        String?
  lastSeenAt        DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tasks             BridgeTask[]

  @@map("pms_connections")
}

/// Work the agent sends to the hotel's own PMS through the bridge.
model BridgeTask {
  id            String        @id @default(cuid())
  propertyId    String
  connectionId  String
  kind          String // LOOKUP | CHECK_IN | CHECK_OUT | NOTE | RATES | FREEFORM
  instruction   String
  payload       Json          @default("{}")
  status        String        @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | NEEDS_HELP | CANCELLED
  result        Json?
  error         String?
  requestedById String
  attempts      Int           @default(0)
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  connection    PmsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status, createdAt])
  @@index([propertyId, createdAt])
  @@map("bridge_tasks")
}

/// A reusable tool for agents. CONFIG skills are generated from a hotel's
/// settings (src/server/skills); LEARNED ones are recorded by agents; MANUAL
/// ones are written by people. propertyId null = platform-wide.
model AgentSkill {
  id          String    @id @default(cuid())
  propertyId  String?
  /// Stable slug, unique per property ("faq-is-parking-free", "rooms").
  key         String
  audience    String    @default("ALL") // GUEST | STAFF | ALL
  kind        String // ANSWER | MACRO | RECIPE
  title       String
  /// When to use it — shown to models.
  description String
  /// JSON Schema for the inputs (MACRO / RECIPE).
  parameters  Json?
  /// ANSWER: { answer } · MACRO: { steps: [{ command }] } · RECIPE: { system, intent, steps, successes?, failures? }
  body        Json
  source      String // CONFIG | LEARNED | MANUAL
  status      String    @default("ACTIVE") // ACTIVE | SUGGESTED | DISABLED
  uses        Int       @default(0)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
  @@index([propertyId, status])
  @@map("agent_skills")
}

/// API keys for trusted integrations (e.g. a partner's AI assistant) that may
/// book directly. Only the SHA-256 of the key is stored. propertyId null = all
/// hotels (platform admins only).
model AgentApiKey {
  id          String    @id @default(cuid())
  propertyId  String?
  name        String
  /// First ~12 characters of the key, safe to display.
  prefix      String
  /// SHA-256 hex of the full key — the key itself is never stored.
  keyHash     String    @unique
  scopes      String[] // e.g. ["book"]
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("agent_api_keys")
}

/// One card payment collected through Stripe on the hotel's connected account. No card data is stored:
/// only the cardholder and risk details Stripe reports for the charge. Kept apart from the guest's name.
model Payment {
  id                      String    @id @default(cuid())
  bookingId               String
  propertyId              String
  stripePaymentIntentId   String    @unique
  stripeChargeId          String?   @unique
  stripeCheckoutSessionId String?
  /// DEPOSIT | FULL
  kind                    String    @default("FULL")
  /// PENDING | SUCCEEDED | FAILED | PARTIALLY_REFUNDED | REFUNDED
  status                  String    @default("PENDING")
  amount                  Decimal   @db.Decimal(10, 2)
  amountRefunded          Decimal   @default(0) @db.Decimal(10, 2)
  applicationFee          Decimal?  @db.Decimal(10, 2)
  currency                String    @default("usd")
  cardholderName          String?
  billingEmail            String?
  billingCountry          String?
  cardCountry             String?
  cardBrand               String?
  cardLast4               String?
  /// Stripe's 3D Secure result: authenticated | attempt_acknowledged | exempted | not_supported | failed | processing_error | not_attempted
  threeDSecure            String?
  /// Stripe Radar outcome: normal | elevated | highest | not_assessed | unknown
  riskLevel               String?
  riskScore               Int?
  failureMessage          String?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property                Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([propertyId, createdAt])
  @@map("payments")
}

/// A card dispute (chargeback) opened on a hotel's Stripe account, with the evidence we assembled for it.
model Dispute {
  id                String    @id @default(cuid())
  stripeDisputeId   String    @unique
  stripeChargeId    String?
  bookingId         String?
  propertyId        String
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("usd")
  reason            String?
  /// Stripe's status: warning_needs_response | needs_response | under_review | won | lost | ...
  status            String
  evidenceDueBy     DateTime?
  /// The evidence summary built from our own records (see src/server/payments/evidence.ts).
  evidenceSummary   Json?
  evidenceSubmittedAt DateTime?
  evidenceSubmittedById String?
  ownerNotifiedAt   DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([bookingId])
  @@map("disputes")
}

/// The cancellation/refund policy a guest accepted at booking: exact text, its hash and version, when and from where.
model BookingPolicyAcceptance {
  bookingId   String   @id
  version     String
  hash        String
  text        String
  acceptedAt  DateTime @default(now())
  ip          String?
  userAgent   String?
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_policy_acceptances")
}

/// Front-desk checklist for bookings carrying risk flags: who ticked what, and when.
model BookingChecklist {
  bookingId             String    @id
  idMatchedAt           DateTime?
  idMatchedById         String?
  cardShownAt           DateTime?
  cardShownById         String?
  registrationSignedAt  DateTime?
  registrationSignedById String?
  updatedAt             DateTime  @updatedAt
  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_checklists")
}

/// Stripe webhook events already handled, so redeliveries are ignored (idempotency).
model StripeEvent {
  id          String    @id
  type        String
  account     String?
  startedAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, startedAt])
  @@map("stripe_events")
}
