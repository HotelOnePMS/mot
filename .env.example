# --- Required ---
DATABASE_URL="postgresql://user:password@localhost:5432/hotelone"
DIRECT_URL="postgresql://user:password@localhost:5432/hotelone"   # unpooled URL for migrations (same as DATABASE_URL locally)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Hotel defaults ---
HOTEL_TIMEZONE="America/Los_Angeles"   # platform default; each hotel sets its own (Settings → Prices and time)
# NEXT_PUBLIC_DEMO_MODE="true"     # show one-click demo logins in production
# AGENT_PLAN_SECRET=""             # separate secret for signed agent plans
# NEXT_PUBLIC_SITE_URL=""          # canonical public address, e.g. https://hotelone.site (metadata, sitemap, Stripe return URLs)

# --- Voice front desk: ElevenLabs (preferred when set) or OpenAI GPT-Live ---
# ELEVENLABS_API_KEY=""          # HotelOne creates and syncs its ElevenLabs agents
# ELEVENLABS_VOICE_ID=""
# ELEVENLABS_LLM="gemini-2.5-flash"
# VOICE_PROVIDER="elevenlabs"      # or "openai"
# HOTELONE_PUBLIC_URL=""           # phone lines + booking links: public https address (default: NEXT_PUBLIC_SITE_URL, else the Vercel production domain); STAYOS_PUBLIC_URL still works
# ELEVENLABS_PHONE_AUDIO_FORMAT="ulaw_8000"   # or "auto"

# --- OpenAI: GPT-Live voice + PMS bridge operator ---
# OPENAI_API_KEY=""
# OPENAI_LIVE_MODEL="gpt-live-1"
# OPENAI_VOICE_BACKEND_MODEL="gpt-6-luna"
# BRIDGE_OPERATOR_MODEL="computer-use-preview"
# BRIDGE_OPERATOR_TOOL="computer_use_preview"   # or "computer"
# HOTELONE_VAULT_KEY=""            # openssl rand -base64 32 (required in production for two-step sign-in, SSO client secrets, cloud bridge logins and card-authorization ID photos); STAYOS_VAULT_KEY still works — keep the same value if you rename it
# BRIDGE_WORKER_SECRET=""          # enables the cloud worker

# --- Anthropic: AI business advisor (Console → AI advisor) ---
# ANTHROPIC_API_KEY=""

# --- Agent platform (all optional) ---
# VOICE_CONCIERGE="off"                       # turn off the all-hotels voice concierge
# VOICE_CONCIERGE_MAX_SESSIONS_PER_HOUR="120"
# AGENT_API_ALLOWED_ORIGINS=""                # browser origins allowed to call /api/mcp and /api/agents/v1
# AGENT_API_READS_PER_MINUTE="120"            # per-IP limits for AI assistants without a key
# AGENT_API_REQUESTS_PER_HOUR="10"
# AGENT_API_LOOKUPS_PER_HOUR="20"
# AGENT_KEYS_PER_HOTEL_DAY="10"               # API keys a hotel can create per day
# AGENT_API_KEY_HOTEL_LOOKUPS_PER_HOUR="300"  # pools shared by all of a hotel's keys
# AGENT_API_KEY_HOTEL_REQUESTS_PER_HOUR="100"
# AGENT_API_KEY_HOTEL_BOOKINGS_PER_HOUR="100"
# CONCIERGE_MAX_REQUESTS_PER_HOTEL_HOUR="20"  # booking requests per hotel per hour (key holders)
# CONCIERGE_MAX_PUBLIC_REQUESTS_PER_HOTEL_HOUR="10"   # ...and from anonymous assistants
# AGENT_CONFIRMATIONS_PER_HOTEL_DAY="50"      # confirmation emails for API-key bookings
# AGENT_CONFIRMATIONS_PER_KEY_DAY="25"
# TRUSTED_PROXY_HOPS="1"                      # off Vercel: X-Forwarded-For entry (from the right) used as the client IP
# PMS_MCP_MODEL=""                            # plans PMS MCP calls for vendors off the HotelOne contract
# PMS_MCP_ALLOWED_HOSTS=""                    # PMS MCP hosts allowed despite the private-address guard
# PMS_EVENTS_SECRET=""                        # base secret for PMS event signatures

# --- Channels: Expedia / Booking.com (all optional, see CHANNEL_MANAGER.md) ---
# CRON_SECRET=""                  # bearer token for /api/channels/cron (Vercel Cron sends it)
# CHANNEL_AGENT_MODEL=""          # Channel Agent model (default OPENAI_VOICE_BACKEND_MODEL); needs OPENAI_API_KEY
# EXPEDIA_EQC_BASE_URL=""         # OTA endpoints, to target a certification environment
# EXPEDIA_API_BASE_URL=""
# BOOKING_COM_SUPPLY_URL=""
# BOOKING_COM_SECURE_URL=""

# --- Payments, email, uploads, sign-in (all optional) ---
# Stripe Connect (see PAYMENTS.md). Without STRIPE_SECRET_KEY every hotel stays on pay-at-property.
# STRIPE_SECRET_KEY=""                  # platform secret key (sk_test_… / sk_live_…)
# STRIPE_WEBHOOK_SECRET=""              # signing secret of the "Your account" webhook endpoint
# STRIPE_CONNECT_WEBHOOK_SECRET=""      # signing secret of the "Connected accounts" endpoint (same URL)
# STRIPE_PLATFORM_FEE_PERCENT=""        # optional platform fee on each charge, e.g. 1.5 (default 0)
# STRIPE_CONNECT_DEFAULT_COUNTRY=""     # optional ISO country pre-filled when a hotel creates its Stripe account, e.g. US
# PAYMENTS_HIGH_AMOUNT_THRESHOLD=""     # bookings at or above this total get a "High amount" flag (default 1000)
# CARD_AUTH_ID_PHOTO_DAYS=""            # card authorizations: days after check-out an ID photo is kept, unless a dispute is open (default 180)
# CRON_SECRET=""                        # optional: lets /api/cron/expire-bookings release unpaid holds and delete expired ID photos (Vercel Cron sends it as a bearer token)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # not needed: payment uses hosted Checkout
# RESEND_API_KEY=""                                # booking confirmations AND password-reset emails; without it reset links are only logged in development (never in production)
# EMAIL_FROM="HotelOne <bookings@hotelone.site>"   # sender for confirmation emails (domain verified in Resend)
# BLOB_READ_WRITE_TOKEN=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Error tracking (optional) ---
# SENTRY_DSN=""                       # server errors, background jobs, uncaught route errors
# NEXT_PUBLIC_SENTRY_DSN=""           # browser errors (Sentry is only downloaded when set)
# SENTRY_ENVIRONMENT=""               # default: VERCEL_ENV or NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE="0"

# --- Sign-in limits (optional) ---
# SIGNUP_MAX_PER_IP_HOUR="10"         # new guest accounts per network per hour

# --- Integration tests ---
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/hotelone_test"   # npm run test:integration (migrations applied, nothing deleted)

# --- Seeding ---
# ADMIN_SEED_PASSWORD=""
# DEMO_PASSWORD="demo1234"
# SEED_DEMO="true"
# ALLOW_SEED_WIPE="false"
