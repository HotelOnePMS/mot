{
  "name": "hotelone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:clean": "bash enhanced-cleanup.sh && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate dev && prisma db seed",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "setup:production": "node scripts/setup-production.js",
    "clean": "bash enhanced-cleanup.sh",
    "predeploy": "bash enhanced-cleanup.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:watch": "vitest --project unit"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
